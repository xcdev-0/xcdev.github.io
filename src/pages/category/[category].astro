---
import CategoryTabs from '../../components/CategoryTabs.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, type Category } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../utils/posts';

export function getStaticPaths() {
	return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const category = Astro.params.category as Category;
const c = CATEGORIES[category];
const posts = await getPosts(category);
---

<Base title={c.label} description={c.description}>
	<div class="container">
		<PageHeader title={`${c.emoji} ${c.label}`} subtitle={`${c.description} · ${posts.length}개의 글`} />
		<CategoryTabs active={category} />
		{
			posts.length ? (
				<div class="post-grid">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			) : (
				<p class="empty">아직 이 카테고리에 글이 없어요.</p>
			)
		}
	</div>
</Base>

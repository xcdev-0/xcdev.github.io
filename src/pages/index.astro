---
import PostCard from '../components/PostCard.astro';
import { AUTHOR_BIO, CATEGORIES, type Category } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const recent = posts.slice(0, 6);
const count = (c: Category) => posts.filter((p) => p.data.category === c).length;
---

<Base>
	<section class="hero container">
		<div class="blob blob-1" aria-hidden="true"></div>
		<div class="blob blob-2" aria-hidden="true"></div>
		<p class="hello">안녕하세요 👋</p>
		<h1>
			<span class="grad-daily">일상</span>과 <span class="grad-dev">개발</span>을<br />
			기록하는 공간이에요
		</h1>
		<p class="bio">{AUTHOR_BIO}</p>
	</section>

	<section class="container cats">
		{
			(Object.keys(CATEGORIES) as Category[]).map((key) => {
				const c = CATEGORIES[key];
				return (
					<a href={`/category/${key}`} class:list={['cat', `cat-${key}`]}>
						<span class="cat-emoji">{c.emoji}</span>
						<div>
							<strong>{c.label}</strong>
							<span>{c.description}</span>
						</div>
						<span class="cat-count">{count(key)}개의 글 →</span>
					</a>
				);
			})
		}
	</section>

	<section class="container recent">
		<div class="recent-head">
			<h2 class="section-title">최근 글</h2>
			<a href="/blog" class="more">전체 보기 →</a>
		</div>
		{
			recent.length ? (
				<div class="post-grid">
					{recent.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			) : (
				<p class="empty">아직 글이 없어요. 첫 글을 써볼까요? ✍️</p>
			)
		}
	</section>
</Base>

<style>
	.hero {
		position: relative;
		padding-top: 5.5rem;
		padding-bottom: 3.5rem;
	}
	.blob {
		position: absolute;
		z-index: -1;
		border-radius: 50%;
		filter: blur(60px);
		opacity: 0.45;
		pointer-events: none;
	}
	.blob-1 {
		width: 320px;
		height: 320px;
		top: 10px;
		right: 8%;
		background: var(--daily);
		animation: float 12s ease-in-out infinite;
	}
	.blob-2 {
		width: 280px;
		height: 280px;
		top: 120px;
		right: 25%;
		background: var(--dev);
		animation: float 14s ease-in-out infinite reverse;
	}
	@keyframes float {
		0%,
		100% {
			transform: translate(0, 0) scale(1);
		}
		50% {
			transform: translate(-30px, 20px) scale(1.08);
		}
	}
	.hello {
		margin: 0 0 0.6rem;
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--text-muted);
	}
	h1 {
		margin: 0;
		font-size: clamp(2.2rem, 6vw, 3.6rem);
		line-height: 1.22;
		letter-spacing: -0.045em;
		font-weight: 800;
	}
	.grad-daily {
		background: linear-gradient(120deg, var(--daily), #f2b45a);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.grad-dev {
		background: linear-gradient(120deg, var(--dev), var(--accent));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.bio {
		margin: 1.2rem 0 0;
		font-size: 1.1rem;
		color: var(--text-muted);
	}

	.cats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
		margin-bottom: 4rem;
	}
	.cat {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.3rem 1.4rem;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		text-decoration: none;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}
	.cat:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-hover);
	}
	.cat-daily {
		background: linear-gradient(135deg, var(--daily-soft), var(--bg-elev));
	}
	.cat-dev {
		background: linear-gradient(135deg, var(--dev-soft), var(--bg-elev));
	}
	.cat-emoji {
		font-size: 2rem;
	}
	.cat div {
		display: flex;
		flex-direction: column;
		line-height: 1.4;
	}
	.cat strong {
		font-size: 1.1rem;
	}
	.cat div span {
		font-size: 0.88rem;
		color: var(--text-muted);
	}
	.cat-count {
		margin-left: auto;
		font-size: 0.85rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.cat-daily .cat-count {
		color: var(--daily);
	}
	.cat-dev .cat-count {
		color: var(--dev);
	}

	.recent-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}
	.more {
		font-size: 0.92rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.more:hover {
		color: var(--accent);
	}
</style>

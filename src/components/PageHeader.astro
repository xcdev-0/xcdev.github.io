---
interface Props {
	title: string;
	subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="page-header">
	<h1>{title}</h1>
	{subtitle && <p>{subtitle}</p>}
</div>

<style>
	.page-header {
		padding: 3.5rem 0 1.5rem;
	}
	h1 {
		margin: 0;
		font-size: clamp(1.9rem, 4vw, 2.5rem);
		letter-spacing: -0.04em;
		line-height: 1.25;
	}
	p {
		margin: 0.5rem 0 0;
		color: var(--text-muted);
	}
</style>

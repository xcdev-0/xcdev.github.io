---
import { CATEGORIES, type Category } from '../consts';

interface Props {
	active?: Category;
}
const { active } = Astro.props;
const tabs = [
	{ href: '/blog', label: '전체', key: undefined },
	...Object.entries(CATEGORIES).map(([key, c]) => ({
		href: `/category/${key}`,
		label: `${c.emoji} ${c.label}`,
		key,
	})),
];
---

<div class="tabs">
	{
		tabs.map((t) => (
			<a href={t.href} class:list={['tab', { active: t.key === active }]}>
				{t.label}
			</a>
		))
	}
</div>

<style>
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}
	.tab {
		padding: 0.45rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--bg-elev);
		font-size: 0.92rem;
		font-weight: 500;
		text-decoration: none;
		color: var(--text-muted);
		transition: all 0.2s ease;
	}
	.tab:hover {
		color: var(--text);
		border-color: var(--text-muted);
	}
	.tab.active {
		background: var(--text);
		border-color: var(--text);
		color: var(--bg);
	}
</style>

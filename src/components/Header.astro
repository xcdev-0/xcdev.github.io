---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const links = [
	{ href: '/blog', label: '전체 글' },
	{ href: '/category/daily', label: '일상' },
	{ href: '/category/dev', label: '개발' },
	{ href: '/about', label: '소개' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-header">
	<nav class="container nav">
		<a href="/" class="logo">
			<span class="logo-mark" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<div class="right">
			<div class="links">
				{
					links.map((l) => (
						<a href={l.href} class:list={['link', { active: isActive(l.href) }]}>
							{l.label}
						</a>
					))
				}
			</div>
			<button id="theme-toggle" class="theme-toggle" aria-label="다크 모드 전환" title="다크 모드 전환">
				<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
				<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
			</button>
		</div>
	</nav>
</header>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: saturate(180%) blur(14px);
		-webkit-backdrop-filter: saturate(180%) blur(14px);
		border-bottom: 1px solid var(--border);
	}
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 64px;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 800;
		font-size: 1.1rem;
		letter-spacing: -0.03em;
		text-decoration: none;
		white-space: nowrap;
	}
	.logo-mark {
		width: 22px;
		height: 22px;
		border-radius: 7px;
		background: linear-gradient(135deg, var(--daily), var(--accent) 55%, var(--dev));
		box-shadow: 0 2px 8px color-mix(in srgb, var(--accent) 40%, transparent);
	}
	.right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}
	.links {
		display: flex;
		gap: 0.2rem;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.link {
		padding: 0.4rem 0.8rem;
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-muted);
		text-decoration: none;
		white-space: nowrap;
		transition: all 0.2s ease;
	}
	.link:hover {
		color: var(--text);
		background: var(--bg-soft);
	}
	.link.active {
		color: var(--text);
		background: var(--bg-soft);
		font-weight: 700;
	}
	.theme-toggle {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		border: 1px solid var(--border);
		background: var(--bg-elev);
		color: var(--text);
		cursor: pointer;
		transition: transform 0.2s ease;
	}
	.theme-toggle:hover {
		transform: rotate(-15deg) scale(1.05);
	}
	.icon-moon,
	:global([data-theme='dark']) .icon-sun {
		display: none;
	}
	:global([data-theme='dark']) .icon-moon {
		display: block;
	}
	@media (max-width: 600px) {
		.logo {
			font-size: 0;
			gap: 0;
		}
		.link {
			padding: 0.4rem 0.6rem;
			font-size: 0.9rem;
		}
	}
</style>
